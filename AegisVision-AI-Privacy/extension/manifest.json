{
  "manifest_version": 3,
  "name": "SentriVision",
  "version": "1.0",
  "description": "ML-Based AI-Safe Webpage Privacy Protection",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "assets/logo/sentrivision-icon-16.png",
    "32": "assets/logo/sentrivision-icon-32.png",
    "48": "assets/logo/sentrivision-icon-48.png",
    "128": "assets/logo/sentrivision-icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/logo/sentrivision-icon-16.png",
      "32": "assets/logo/sentrivision-icon-32.png",
      "48": "assets/logo/sentrivision-icon-48.png",
      "128": "assets/logo/sentrivision-icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5500/*", "<all_urls>"],
      "js": ["content/content.js"]
    }
  ]
}
